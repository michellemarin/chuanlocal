      "surface": {
        "$value": "{color.white}",
        "$type": "color",
        "$description": "Cards, lists and form panels on the page.",
        "$extensions": {
          "dark": "{color.navy-900}"
        }
      },
      "subtle": {
        "$value": "{color.navy-50}",
        "$type": "color",
        "$description": "A quiet band that groups things without a border (highlighted blocks, sticky bars).",
        "$extensions": {
          "dark": "{color.navy-850}"
        }
      }
    },
    "foreground": {
      "primary": {
        "$value": "{color.navy-900}",
        "$type": "color",
        "$description": "Body text, names, prices, headings.",
        "$extensions": {
          "dark": "{color.white}"
        }
      },
      "secondary": {
        "$value": "{color.navy-700}",
        "$type": "color",
        "$description": "The quieter line: supporting text, the original-language line under a translation, unavailable items.",
        "$extensions": {
          "dark": "{color.navy-200}"
        }
      },
      "link": {
        "$value": "{color.navy-900}",
        "$type": "color",
        "$description": "Inline links. Always underlined.",
        "$extensions": {
          "dark": "{color.white}"
        }
      },
      "error": {
        "$value": "{color.navy-900}",
        "$type": "color",
        "$description": "Error message text. The clay mark beside it carries the signal.",
        "$extensions": {
          "dark": "{color.white}"
        }
      },
      "on-brand": {
        "$value": "{color.white}",
        "$type": "color",
        "$description": "Text and icons on color.accent.brand. White text appears only on Chuan Navy.",
        "$extensions": {
          "dark": "{color.navy-900}"
        }
      },
      "on-brand-hover": {
        "$value": "{color.white}",
        "$type": "color",
        "$description": "Text on color.accent.brand-hover.",
        "$extensions": {
          "dark": "{color.navy-900}"
        }
      }
    },
    "border": {
      "default": {
        "$value": "{color.navy-700}",
        "$type": "color",
